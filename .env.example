# ============================================================
# LifeFlow — Environment Variables Reference
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local      (Linux / macOS)
#   copy .env.example .env.local    (Windows)
#
# Fill in real values. NEVER commit .env.local or any file
# containing real secrets to version control.
#
# Production deployments: set these as environment variables
# in your hosting platform (Vercel, AWS, Azure, Docker, etc.)
# ============================================================

# ── Database ──────────────────────────────────────────────────
# MongoDB connection string (required).
# Local dev:    mongodb://localhost:27017/lifeflow
# Atlas:        mongodb+srv://<user>:<password>@cluster.mongodb.net/lifeflow?retryWrites=true&w=majority
# NEVER put real credentials here — use .env.local or your platform's secret manager.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

# MongoDB database name (optional, defaults to "lifeflow")
MONGODB_DB_NAME=lifeflow

# ── Authentication ─────────────────────────────────────────────
# iron-session encryption secret (required).
# Must be at least 32 characters long.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Application URL ────────────────────────────────────────────
# Full public URL of the application (no trailing slash).
# Development:  http://localhost:3000
# Production:   https://your-domain.com  (or your EC2 HTTP URL until you add HTTPS)
# Used to construct email verification links — must be reachable by users.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default currency shown in the UI.
# Examples: INR, USD, EUR, GBP
NEXT_PUBLIC_CURRENCY=INR

# ── Scheduler / Cron ───────────────────────────────────────────
# Secret used to authenticate the subscription scheduler endpoint:
#   POST /api/jobs/process-subscriptions
#   GET  /api/subscriptions/process  (legacy alias)
#
# Vercel Cron: set this as CRON_SECRET — Vercel passes it automatically.
# AWS / Azure / VM: pass as:  Authorization: Bearer <SCHEDULER_SECRET>
# Generate with: openssl rand -base64 32
SCHEDULER_SECRET=
CRON_SECRET=

# ── Storage Provider ───────────────────────────────────────────
# Where to store uploaded transaction screenshots.
#
#   mongodb  — store as base64 in MongoDB (default; zero extra setup)
#   s3       — AWS S3 or S3-compatible (Cloudflare R2, MinIO, etc.)
#   azure    — Azure Blob Storage
#   local    — local filesystem (DEVELOPMENT ONLY, never use in production)
STORAGE_PROVIDER=mongodb

# ─ S3 / S3-compatible storage (required when STORAGE_PROVIDER=s3) ─
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
# Leave blank to use IAM role / instance profile credentials (recommended on AWS).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Custom endpoint for S3-compatible stores (Cloudflare R2, MinIO, etc.).
# Leave blank for standard AWS S3.
STORAGE_ENDPOINT=

# ─ Azure Blob Storage (required when STORAGE_PROVIDER=azure) ─
AZURE_STORAGE_ACCOUNT_NAME=
# Leave blank to use Managed Identity (recommended on Azure VMs / Container Apps).
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=transaction-proofs

# ── OCR Provider ───────────────────────────────────────────────
# Which OCR engine to use for transaction screenshot processing.
#
#   auto          — try Google Vision first, fall back to Tesseract (default)
#   google_vision — Google Cloud Vision API only
#   tesseract     — Tesseract.js only (offline, no API key needed)
OCR_PROVIDER=auto

# Google Cloud Vision API key (optional — enables high-accuracy OCR).
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable: Cloud Vision API
GOOGLE_VISION_API_KEY=

# Generic OCR API key alias (used if GOOGLE_VISION_API_KEY is not set).
OCR_API_KEY=

# ── Email / Notifications ──────────────────────────────────────
# External email delivery.
# Required for email verification and 2FA security notifications.
#
# Supported providers:
#   none      — no email delivery (default; email verification will silently skip)
#   smtp      — Any SMTP relay (Gmail, Mailgun, Brevo, Postfix, etc.) — RECOMMENDED
#   resend    — Resend.com  (https://resend.com)
#   sendgrid  — SendGrid    (https://sendgrid.com)
#
# For production on EC2, set EMAIL_PROVIDER=smtp and configure the SMTP
# section below. Do NOT use Amazon SES — standard SMTP is sufficient.
EMAIL_PROVIDER=smtp

# API key for Resend or SendGrid (only used when EMAIL_PROVIDER=resend or sendgrid).
EMAIL_API_KEY=

# Sender address shown in the "From" field of outgoing emails.
# Must be a valid address on your sending domain.
EMAIL_FROM=lifeflow4u.noreply@gmail.com

# Display name shown alongside the From address.
# Example: recipients will see "LifeFlow <noreply@yourdomain.com>"
EMAIL_FROM_NAME=LifeFlow

# ─ SMTP settings (required when EMAIL_PROVIDER=smtp) ──────────
# Use any SMTP relay service. Examples:
#
#   Gmail (App Password):
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USER=your@gmail.com
#     SMTP_PASSWORD=<16-char app password from https://myaccount.google.com/apppasswords>
#
#   Brevo (formerly Sendinblue) — free tier, good for EC2:
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_PORT=587
#     SMTP_USER=your@email.com
#     SMTP_PASSWORD=<brevo smtp key>
#
#   Mailgun:
#     SMTP_HOST=smtp.mailgun.org
#     SMTP_PORT=587
#     SMTP_USER=postmaster@mg.yourdomain.com
#     SMTP_PASSWORD=<mailgun smtp password>
#
# Port 587 uses STARTTLS (recommended).
# Port 465 uses implicit TLS — set SMTP_PORT=465 if your provider requires it.
# Port 25 is blocked on most cloud providers including AWS EC2 — avoid it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lifeflow4u.noreply@gmail.com
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Gmail account)
# The App Password is 16 characters with spaces, e.g.  xxxx xxxx xxxx xxxx
# NEVER commit the real value — set it only in .env.local or your platform secret manager.
SMTP_PASSWORD=

# ── Two-Factor Authentication (TOTP) ───────────────────────────
# AES-256-GCM encryption key for TOTP secrets stored in MongoDB.
# REQUIRED if any user enables Google Authenticator 2FA.
#
# Must be a 64-character lowercase hex string (32 bytes = 256 bits).
# Generate a secure value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# KEEP THIS SECRET. If this key is lost, all users with 2FA enabled
# will be permanently locked out and will need to use recovery codes.
# Rotate it only through a controlled migration process.
TOTP_ENCRYPTION_KEY=

# ── Email Verification Timing ──────────────────────────────────
# How long (in minutes) an email verification token remains valid.
# Default: 8 minutes.
VERIFICATION_TOKEN_EXPIRY_MINUTES=8

# Minimum gap (in seconds) between two resend requests for the same email.
# Default: 60 seconds.
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Maximum number of resend requests allowed per email address per hour.
# Default: 5.
VERIFICATION_MAX_RESENDS_PER_HOUR=5

# ── Application Defaults ───────────────────────────────────────
# Default timezone for date/time calculations (IANA timezone name).
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DEFAULT_TIMEZONE=Asia/Kolkata

# Logging level: debug | info | warn | error
# Production default: info
LOG_LEVEL=info
