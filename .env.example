# ============================================================
# LifeFlow — Environment Variables Reference
# ============================================================
# Copy to .env.local for local development:
#   Linux / macOS:  cp .env.example .env.local
#   Windows:        copy .env.example .env.local
#
# Fill in real values in .env.local.
# NEVER commit .env.local or any file with real secrets.
#
# ── Three-environment model ────────────────────────────────────
#
#   LOCAL   → .env.local      NEXT_PUBLIC_APP_URL=http://localhost:3000
#   AWS     → .env on server  NEXT_PUBLIC_APP_URL=http://<EC2-IP>:3000
#                               or https://<your-domain>
#   AZURE   → .env on server  NEXT_PUBLIC_APP_URL=http://<Azure-IP>:3000
#                               or https://<your-domain>
#
# Only the environment configuration changes between deployments —
# never the application source code.
#
# Production deployments: set these as environment variables in
# your hosting platform (AWS EC2, Azure VM, Docker, etc.)
# ============================================================

# ── Application URL ────────────────────────────────────────────
# Full public URL of the application — no trailing slash.
# This value is embedded in verification emails and controls the
# session-cookie Secure flag (https:// → Secure; http:// → not Secure).
#
#   Local dev:   http://localhost:3000
#   AWS HTTP:    http://<EC2-IP>:3000
#   AWS HTTPS:   https://<your-domain>
#   Azure HTTP:  http://<Azure-IP>:3000
#   Azure HTTPS: https://<your-domain>
#
# NEVER hard-code an IP or domain in source code — only here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default currency displayed in the UI.
# Examples: INR, USD, EUR, GBP
NEXT_PUBLIC_CURRENCY=INR

# ── Database ───────────────────────────────────────────────────
# MongoDB connection string (required).
#
#   Local MongoDB:  mongodb://localhost:27017/lifeflow
#   Atlas:          mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=Cluster0
#
# NEVER put real credentials here.
MONGODB_URI=

# Database name (optional — defaults to "lifeflow").
MONGODB_DB_NAME=lifeflow

# ── Authentication ─────────────────────────────────────────────
# iron-session AES-GCM encryption secret (required, ≥ 32 characters).
#
# Generate (Linux / macOS / Git Bash):
#   openssl rand -base64 32
#
# Generate (Windows PowerShell):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#
# Generate (Node.js — any platform):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Use a DIFFERENT secret for each environment (local / AWS / Azure).
SESSION_SECRET=

# ── Scheduler / Cron ───────────────────────────────────────────
# Protects POST /api/jobs/process-subscriptions.
# Pass as:  Authorization: Bearer <secret>
# Generate the same way as SESSION_SECRET above.
SCHEDULER_SECRET=
CRON_SECRET=

# ── Two-Factor Authentication (TOTP) ───────────────────────────
# AES-256-GCM key for TOTP secrets stored in MongoDB.
# Required when any user enables Google Authenticator 2FA.
#
# Must be a 64-character lowercase hex string (32 bytes).
# Generate (any platform):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# KEEP THIS SECRET. Losing it permanently locks out all 2FA users.
# Use a DIFFERENT key for each environment.
TOTP_ENCRYPTION_KEY=

# ── Email / Notifications ──────────────────────────────────────
# Required for email verification and 2FA security alerts.
#
# Providers:
#   none      — no email (default; verification silently skipped)
#   smtp      — any SMTP relay — RECOMMENDED for local dev and EC2/Azure
#   resend    — Resend.com
#   sendgrid  — SendGrid
EMAIL_PROVIDER=smtp

# Sender address and display name.
EMAIL_FROM=
EMAIL_FROM_NAME=LifeFlow

# API key (only for EMAIL_PROVIDER=resend or sendgrid).
EMAIL_API_KEY=

# ── SMTP (required when EMAIL_PROVIDER=smtp) ───────────────────
# Works with any SMTP relay. Local dev example using Gmail App Password:
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-char App Password from myaccount.google.com/apppasswords>
#
# Other relays (Brevo, Mailgun, Postfix) work the same way — just
# change SMTP_HOST / SMTP_USER / SMTP_PASSWORD.
#
# Port 587  → STARTTLS (recommended)
# Port 465  → implicit TLS
# Port 25   → blocked on most cloud VMs — avoid
#
# Do NOT use localhost as SMTP_HOST.
# NEVER commit the real password — only in .env.local or platform secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Email Verification Timing ──────────────────────────────────
# Token validity window (minutes). Default: 8.
VERIFICATION_TOKEN_EXPIRY_MINUTES=8

# Minimum seconds between two resend requests for the same address. Default: 60.
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Maximum resend requests per email per hour. Default: 5.
VERIFICATION_MAX_RESENDS_PER_HOUR=5

# ── Storage Provider ───────────────────────────────────────────
# Where to store uploaded receipts / screenshots.
#
#   mongodb  — base64 in Atlas (default; zero extra setup)
#   s3       — AWS S3 or S3-compatible (Cloudflare R2, MinIO, etc.)
#   azure    — Azure Blob Storage
#   local    — local filesystem (dev only, never production)
STORAGE_PROVIDER=mongodb

# ─ S3 / S3-compatible (required when STORAGE_PROVIDER=s3) ──────
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
# Leave blank to use IAM instance profile credentials (recommended on EC2).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Custom endpoint for non-AWS S3-compatible services (R2, MinIO, etc.).
# Leave blank for standard AWS S3.
STORAGE_ENDPOINT=

# ─ Azure Blob Storage (required when STORAGE_PROVIDER=azure) ───
AZURE_STORAGE_ACCOUNT_NAME=
# Leave blank to use Managed Identity (recommended on Azure VMs).
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=transaction-proofs

# ── OCR Provider ───────────────────────────────────────────────
#   auto          — Google Vision first, Tesseract fallback (default)
#   google_vision — Google Cloud Vision API only
#   tesseract     — Tesseract.js only (offline, no API key needed)
OCR_PROVIDER=auto

# Google Cloud Vision API key (optional).
GOOGLE_VISION_API_KEY=
OCR_API_KEY=

# ── Web Push / VAPID ──────────────────────────────────────────
# Required for browser push notifications (Web Push + VAPID).
#
# Generate a key pair (one-time setup):
#   npx web-push generate-vapid-keys
#
# Copy the output into the fields below.
#
# NEXT_PUBLIC_VAPID_PUBLIC_KEY  — safe to expose to the browser (prefixed NEXT_PUBLIC_).
# VAPID_PRIVATE_KEY             — SERVER ONLY — never prefix with NEXT_PUBLIC_.
# VAPID_SUBJECT                 — must be either a mailto: or https: URI identifying
#                                 the push notification sender.
#
# Use the SAME key pair across restarts; changing keys invalidates all existing
# browser subscriptions and forces users to re-subscribe.
#
# Leave blank to disable push notifications entirely (in-app + email still works).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:lifeflow4u.noreply@gmail.com

# ── Application Defaults ───────────────────────────────────────
# IANA timezone name. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DEFAULT_TIMEZONE=Asia/Kolkata

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# ── Email Notification Settings ────────────────────────────────
# The notification email system uses the same SMTP transport as email
# verification.  No additional configuration is required beyond setting
# EMAIL_PROVIDER=smtp and the SMTP_* variables above.
#
# Users control per-category email preferences through their LifeFlow
# profile settings (/app/profile → Notifications → Email notifications).
#
# Email notifications are OFF by default for all users.  Users must
# explicitly enable them in their profile.
#
# ── Notification Email Categories ──────────────────────────────
# Users can independently control email delivery for each category:
#
#   taskReminders   — tomorrow's tasks + end-of-day incomplete reminder
#   habitReminders  — tomorrow's habits reminder
#   spendingAlerts  — budget threshold alerts (80% / 100%)
#   dailySummary    — morning summary of tasks, habits, and spending
#
# ── Email Recipient Security ────────────────────────────────────
# Notification emails are ALWAYS sent to the recipient's own registered
# LifeFlow account email address.
# The server resolves: authenticated session → userId → database → email.
# No client-supplied recipient address is ever accepted.
#
# ── Test Email Endpoint ────────────────────────────────────────
# POST /api/notifications/test-email
# Requires: authenticated session
# Rate limit: 3 requests per user per hour
# Sends a test email to the logged-in user's own registered address.
#
# ── Sender Identity ────────────────────────────────────────────
# All notification emails are sent From:
#   <EMAIL_FROM_NAME> <EMAIL_FROM>
# e.g.
#   LifeFlow <lifeflow4u.noreply@gmail.com>
#
# The user's OWN Gmail password or App Password is NEVER required.
# Only the SMTP_USER account (the single sender) needs an App Password.
