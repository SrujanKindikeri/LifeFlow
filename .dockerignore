# LifeFlow — .dockerignore
# Excludes files that should not be copied into the Docker build context.
# Keeps the build fast and prevents secrets from leaking into the image.

# Dependencies (reinstalled inside the image)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (rebuilt inside the image)
.next
out
build

# Environment files — NEVER include secrets in the image
.env
.env.*
!.env.example

# Local development uploads (not for production)
uploads/

# Version control
.git
.gitignore

# Editor and OS files
.DS_Store
*.pem
.vscode
.idea

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Test coverage
coverage

# README and docs (not needed at runtime)
README.md
AGENTS.md
CLAUDE.md
docs/
